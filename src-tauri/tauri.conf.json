{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultTask",
  "version": "0.4.4",
  "identifier": "com.vaulttask.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VaultTask",
        "width": 420,
        "height": 620,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VaultTask",
    "category": "Utility",
    "shortDescription": "Encrypted tray task manager with Markdown notes",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3"
        ],
        "recommends": [
          "gnome-shell-extension-appindicator"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/shridhargsabat/vault-task/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMjAxNEUxMzZFNDA5MUYKUldRZkNlUTI0UlFnZlo0UUtxWUdtWHVBWEpQS1lzRjBUTkJjQjhBak93dnl1cFpjUEdSVU5qR2UK"
    }
  }
}
